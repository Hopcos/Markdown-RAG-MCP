{
  // Optional bearer token protecting EVERY HTTP request (the /mcp Streamable HTTP
  // endpoint). When non-empty, all requests must send: Authorization: Bearer <value>.
  // Can be overridden with the environment variable "server-token" (or "ServerToken").
  // Leave empty to disable authentication. Only applies to the "Http" transport; the
  // stdio transport (a trusted child process of the MCP client) is unaffected.
  "server-token": "",

  "MarkdownRag": {
    "Transport": "Stdio",
    "TransportSettings": {
      "HttpEndpointUrl": "http://localhost:3001",
      "HttpRoutePrefix": "",
      "Stateless": true
    },
    "DatabasePath": "./.db",
    "CollectionName": "markdown_vectors",
    "TrackingFileName": "index_tracking.json",
    "VectorStoreFileName": "vectors.json",

    "Embedding": {
      "Provider": "Onnx",
      "Dimension": 384,
      "ModelId": "sentence-transformers/all-MiniLM-L6-v2",
      "ModelCachePath": "./.models/embeddings",
      "MaxSequenceLength": 256,
      "PoolingMode": "Mean"
    },

    "Chunking": {
      "ChunkSize": 512,
      "ChunkOverlap": 100
    },

    "Search": {
      "DefaultLimit": 5
    },

    "Indexing": {
      "BatchSize": 32
    }
  }
}
