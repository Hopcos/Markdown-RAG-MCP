<Project Sdk="Microsoft.NET.Sdk.Web">
<!-- Web SDK: the ASP.NET Core framework reference is built in (no explicit
     Microsoft.AspNetCore/Extensions package references are needed). The HTTP
     transport doubles as the externally-exposed web surface: Swagger UI,
     CORS, discovery endpoints and the MCP endpoint live in the same pipeline.
     The stdio transport runs on Microsoft.Extensions.Hosting, which the
     framework also provides. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MarkdownRagMcp</RootNamespace>
    <AssemblyName>mcp-markdown-rag</AssemblyName>
    <!-- MCP communicates over stdin/stdout; logging must go to stderr only. -->
    <ConsoleRedirectionCheckEnabled>false</ConsoleRedirectionCheckEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.0.0" />
    <!-- Streamable HTTP transport (Kestrel-based) when Transport=Http is selected. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.0.0" />

    <!-- Swagger UI + OpenAPI document for the HTTP discovery surface. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />

    <!-- Local-first ONNX embedding pipeline. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="1.0.1" />

    <!-- FileSystem abstraction for testable file IO. -->
    <PackageReference Include="System.IO.Abstractions" Version="21.0.29" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.hopcos.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
