{
  "MarkdownRag": {
    "DatabasePath": "./.db",
    "CollectionName": "markdown_vectors",
    "TrackingFileName": "index_tracking.json",
    "VectorStoreFileName": "vectors.json",

    "Embedding": {
      "Provider": "Onnx",
      "Dimension": 384,
      "ModelId": "sentence-transformers/all-MiniLM-L6-v2",
      "ModelCachePath": "./.models/embeddings",
      "MaxSequenceLength": 256,
      "PoolingMode": "Mean"
    },

    "Chunking": {
      "ChunkSize": 512,
      "ChunkOverlap": 100
    },

    "Search": {
      "DefaultLimit": 5
    },

    "Indexing": {
      "BatchSize": 32
    }
  }
}
