<Project Sdk="Microsoft.NET.Sdk.Web">
<!-- Web SDK: the ASP.NET Core framework reference is built in (no explicit
     Microsoft.AspNetCore/Extensions package references are needed), so a future
     REST API surface (Swagger UI, static files, minimal-API endpoints) can be
     added without restructuring the project. The stdio transport runs on
     Microsoft.Extensions.Hosting, which the framework also provides. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MarkdownRagMcp</RootNamespace>
    <AssemblyName>mcp-markdown-rag</AssemblyName>
    <!-- MCP communicates over stdin/stdout; logging must go to stderr only. -->
    <ConsoleRedirectionCheckEnabled>false</ConsoleRedirectionCheckEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.0.0" />
    <!-- Streamable HTTP transport (Kestrel-based) when Transport=Http is selected. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.0.0" />

    <!-- Local-first ONNX embedding pipeline. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="1.0.1" />

    <!-- FileSystem abstraction for testable file IO. -->
    <PackageReference Include="System.IO.Abstractions" Version="21.0.29" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.hopcos.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The Web SDK (via Razor -> StaticWebAssets -> StaticAssets.ProjectSystem.props) globs every
         *.config/*.json recursively into @(Content) with CopyToOutputDirectory=PreserveNewest. The SDK's
         default excludes only cover this project's own bin/obj folders, so the tests project's bin/obj
         output JSON files get globbed as content, assigned solution-relative TargetPaths, and copied
         into both projects' output folders, where they re-glob and grow ~2 levels per build. Exclude
         them via the documented Web SDK content-glob knob to break the loop at its source. -->
    <DefaultWebContentItemExcludes>$(DefaultWebContentItemExcludes);tests\McpMarkdownRag.Tests\bin\**;tests\McpMarkdownRag.Tests\obj\**</DefaultWebContentItemExcludes>
  </PropertyGroup>

</Project>
